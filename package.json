{
  "name": "clone-tabnews",
  "version": "1.0.0",
  "description": "Implementação do https://www.tabnews.com.br para o https://curso.dev",
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "lint:check": "npm run lint:code && npm run format:check",
    "lint:fix": "eslint . --fix --max-warnings=0 && npm run format:fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "build": "npm run lint:code && next build --no-lint",
    "start": "next start",
    "services:up": "docker compose --env-file .env.development.local -f infra/compose.yaml up -d --wait",
    "services:down": "docker compose --env-file .env.development.local -f infra/compose.yaml down",
    "test:unit": "jest --runInBand tests/unit",
    "test:integration": "jest --runInBand tests/integration",
    "migrations:up": "node scripts/migrate.js up",
    "migrations:down": "node scripts/migrate.js down",
    "migrations:plan": "node scripts/migrate.js up --dry-run",
    "migrations:create": "node scripts/migrate.js create",
    "test:smoke": "node scripts/smoke-status.js",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint:code": "eslint . --max-warnings=0",
    "prepare": "node scripts/install-hooks.js",
    "lint:commits": "commitlint"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "next": "^13.1.6",
    "pg": "^8.23.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@eslint/compat": "1.4.1",
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "13.1.6",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "jest": "^29.6.2",
    "node-pg-migrate": "7.6.0",
    "prettier": "^3.3.3"
  }
}
